# Database
MONGODB_URI=
MONGODB_DB_NAME=placeble

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
API_PORT=5000
APP_ORIGIN=http://localhost:3000

# Resume Copilot (keys stay on the backend)
AI_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Used for job-matching embeddings (Sarvam has no embeddings API), and as
# alternate AI_PROVIDER choices. Interview audio transcription always uses
# this Gemini/OpenAI pair regardless of AI_PROVIDER.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Switch AI_PROVIDER to openai when an OpenAI key is available
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional isolated code execution for Aptitude coding questions
JUDGE0_ENDPOINT=
JUDGE0_API_KEY=

# Gmail / Google Workspace SMTP. Use an App Password, NEVER your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Actual Google mailbox used to authenticate (may differ from an authorized alias)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@placeble.in
# Inbox that receives messages from the public website contact form (POST /api/v1/public/contact).
CONTACT_NOTIFY_EMAIL=support@placeble.in
# Links in emails (verify email, reset password, invites) use this origin.
# Leave blank in production to use https://app.placeble.in; set it for staging.
APP_LINK_ORIGIN=
# APP_ORIGIN above is the CORS allow-list and must include https://app.placeble.in.

# Razorpay (B2C Pro plans). Use test keys (rzp_test_...) until you go live.
# Dashboard > Settings > API Keys for the key pair, and Settings > Webhooks for the secret.
# Webhook URL: https://api.placeble.in/api/v1/billing/webhook  (events: payment.captured, payment.failed, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Pro prices in rupees (defaults shown)
PRO_PRICE_MONTHLY_INR=149
PRO_PRICE_YEARLY_INR=1499

# Local development seed only
SEED_DEMO_PASSWORD=

# One-time production platform-admin seed (never exposed in the UI)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
