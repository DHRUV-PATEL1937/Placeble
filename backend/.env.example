# Database
MONGODB_URI=
MONGODB_DB_NAME=placeble

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
API_PORT=5000
APP_ORIGIN=http://localhost:3000

# Resume Copilot (keys stay on the backend)
AI_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Used for job-matching embeddings (Sarvam has no embeddings API), and as
# alternate AI_PROVIDER choices. Interview audio transcription always uses
# this Gemini/OpenAI pair regardless of AI_PROVIDER.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Switch AI_PROVIDER to openai when an OpenAI key is available
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional isolated code execution for Aptitude coding questions
JUDGE0_ENDPOINT=
JUDGE0_API_KEY=

# Optional providers (not required for local email/password auth)
EMAIL_PROVIDER=
EMAIL_PROVIDER_KEY=

# Local development seed only
SEED_DEMO_PASSWORD=

# One-time production platform-admin seed (never exposed in the UI)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
