# Database
MONGODB_URI=
MONGODB_DB_NAME=placeble

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
API_PORT=4000
APP_ORIGIN=http://localhost:3000

# Resume Copilot (keys stay on the backend)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Switch AI_PROVIDER to openai when an OpenAI key is available
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional isolated code execution for Aptitude coding questions
JUDGE0_ENDPOINT=
JUDGE0_API_KEY=

# Optional providers (not required for local email/password auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_PROVIDER=
EMAIL_PROVIDER_KEY=

# Local development seed only
SEED_DEMO_PASSWORD=
